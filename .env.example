# Copy this file to .env and fill in your real values.
# .env is in .gitignore — never commit real credentials.

# PostgreSQL RDS connection string
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://postgres:yourpassword@your-rds-endpoint.rds.amazonaws.com:5432/votes

# Comma-separated list of allowed frontend origins
# For production, replace with your actual domain
CORS_ORIGINS=http://localhost:3000
